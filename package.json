{
  "name": "ztlzdrf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lyžiarske podmienky v strediskách pri Gnesau (Bad Kleinkirchheim, Falkert, Turracher Höhe, Hochrindl): najbližší deň, 3 dni a 10-dňový výhľad z Open-Meteo",
  "scripts": {
    "build": "tsc",
    "ski": "tsx src/ski.ts",
    "test": "tsx --test src/*.test.ts scripts/lib/*.test.ts",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "truth:fetch": "tsx scripts/truth-fetch.ts",
    "truth": "tsx scripts/truth-report.ts",
    "backtest:fetch": "tsx scripts/backtest-fetch.ts",
    "backtest": "tsx scripts/backtest-report.ts",
    "model": "tsx scripts/model-fit.ts",
    "verify": "tsx scripts/verify-prospective.ts",
    "rules": "tsx scripts/rules-verify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
